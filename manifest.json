{
  "id": "occasions",
  "contexts": ["household", "shared_space"],
  "name": "Occasions",
  "version": "1.0.0",
  "description": "Birthdays, anniversaries, memorials, holidays, and gift reminders \u2014 one shared list of the dates your household doesn't want to miss, with countdowns to what's coming up. Pull dates in from your Contacts, or add your own.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "general",
  "tags": [
    "dates",
    "birthdays",
    "anniversaries",
    "reminders",
    "occasions",
    "gifts"
  ],
  "icon": "\ud83c\udf82",
  "data_access": {
    "reads": [
      "family.members",
      "app.contacts.contact_dates"
    ],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "automation_actions": {
    "add_occasion": {
      "title": "Record a date to remember",
      "description": "Add a birthday, anniversary or milestone when another app's event carries one - a new contact, a new family record, a trip that got booked.",
      "params": {
        "member": { "type": "member", "label": "Recorded for", "required": true },
        "title": { "type": "text", "label": "Who or what", "required": true },
        "month": { "type": "integer", "label": "Month (1-12)", "required": true, "min": 1, "max": 12 },
        "day": { "type": "integer", "label": "Day of month", "required": true, "min": 1, "max": 31 },
        "kind": {
          "type": "text",
          "label": "Kind",
          "default": "birthday",
          "options": ["birthday", "anniversary", "memorial", "holiday", "gift", "other"]
        }
      },
      "dedupe": { "table": "occasions", "column": "source_event_id" },
      "steps": [
        {
          "op": "insert",
          "table": "occasions",
          "values": {
            "id": "$uuid",
            "member_id": ":member",
            "kind": ":kind",
            "title": ":title",
            "event_month": ":month",
            "event_day": ":day",
            "source": "manual",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "publishes": [
    "occasion.created"
  ],
  "publish_acls": {
    "occasion.created": { "require_role": "member" }
  },
  "db_plaintext_columns": [
    "kind",
    "source",
    "event_month",
    "event_day",
    "event_year",
    "lead_days",
    "remind",
    "countdown"
  ],
  "row_policies": {
    "occasions": {
      "kind": "owner_or_visibility",
      "member_column": "member_id",
      "visibility_column": "visibility",
      "everyone_values": [
        "everyone"
      ],
      "write_visibility_scoped": true
    }
  },
  "member_references": {
    "occasions": {
      "column": "member_id",
      "on_removed": "delete",
      "file_id_column": "photo_file_id",
      "only_when": { "column": "visibility", "values": ["private"] }
    }
  },
  "required_capabilities": [
    "cron",
    "email"
  ],
  "date_reminders": {
    "table": "occasions",
    "month_column": "event_month",
    "day_column": "event_day",
    "lead_days_column": "lead_days",
    "enabled_column": "remind",
    "title_column": "title",
    "kind_column": "kind",
    "one_shot_kind_values": [
      "milestone"
    ],
    "one_shot_year_column": "event_year",
    "owner_column": "member_id",
    "visibility_column": "visibility",
    "everyone_values": [
      "everyone"
    ],
    "last_reminded_column": "last_reminded_at"
  },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT title AS title, emoji AS emoji, member_id AS member_id, CASE WHEN kind = 'milestone' THEN printf('%04d-%02d-%02d', event_year, event_month, event_day) WHEN printf('%02d-%02d', event_month, event_day) >= substr(:today, 6, 5) THEN printf('%04d-%02d-%02d', CAST(substr(:today, 1, 4) AS INTEGER), event_month, event_day) ELSE printf('%04d-%02d-%02d', CAST(substr(:today, 1, 4) AS INTEGER) + 1, event_month, event_day) END AS at FROM app_occasions__occasions WHERE countdown = 1 AND visibility = 'everyone' AND (kind <> 'milestone' OR (event_year IS NOT NULL AND printf('%04d-%02d-%02d', event_year, event_month, event_day) >= :today)) ORDER BY at LIMIT 3"
    },
    "display": {
      "template": "list",
      "title": "title",
      "when": "at",
      "icon": "emoji",
      "owner": "member_id"
    },
    "ambient_card": "countdown"
  },
  "agenda": {
    "kind": "event",
    "label": "Occasion",
    "source": {
      "kind": "sql",
      "query": "SELECT id AS id, title AS title, :today AS when_at FROM app_occasions__occasions WHERE event_month = CAST(strftime('%m', :today) AS INTEGER) AND event_day = CAST(strftime('%d', :today) AS INTEGER) AND (kind <> 'milestone' OR event_year = CAST(strftime('%Y', :today) AS INTEGER)) LIMIT 20"
    }
  },
  "nav": {
    "label": "Occasions"
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": [
      "upcoming_occasions"
    ]
  }
}
